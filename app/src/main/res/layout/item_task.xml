<?xml version="1.0" encoding="utf-8"?>
<!--
  任务卡片（v3.34.77 参照 app_html/dark-task-cards.html 的 .task-card 重排）：
  完成勾移到右上（标题行同排），信息行收进底部 footer（左信息 · 右编辑⋯），
  footer 上方一圈发丝线分隔 —— 「完成右上、编辑右下、清单底部」的操作分工。
  左边缘优先级色条保留（bindPriorityBar 按 priority 染色）。
  状态底色（已完成淡绿 / 待完成淡红）仍由 MainActivity 按状态覆盖。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/app_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_stroke"
    app:strokeWidth="1dp">

    <!--
      左边缘优先级色条：高=红、低=灰，中档不显示（默认档不该到处挂标记）。
      只在需要时出现，所以默认 gone，由 bindTask 按 priority 打开。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/barPriority"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <!--
              顶行：标题区（权重撑满）+ 完成勾右上（v3.34.77，dark-task-cards 的
              task-top 排法）。勾从左侧动作列挪过来；有进度条的任务仍由 bindTask
              隐藏完成钮（打卡走进度区）。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTaskName"
                        style="@style/Text.Taktu.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/f_name"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvTaskStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 完成钮（v3.34.82）：30dp 小圆钮，√ 保留，完成与否看底色（玻璃 → 红） -->
                <ImageButton
                    android:id="@+id/btnToggle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_glass"
                    android:contentDescription="@string/mark_done"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_check"
                    app:tint="@color/accent" />
            </LinearLayout>

            <!--
              逐时刻行（v3.34.21）：多时刻任务每个时刻各占一行 ——
              目标 · 始 · 止 + 这一时刻自己的勾。由 bindTask 动态填充，默认 gone。
            -->
            <LinearLayout
                android:id="@+id/rowTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!--
              清单（子项）：一条任务一张单子 —— 采购明细、训练动作都写在这里。
              点标题行展开 / 收起，每项可勾。提醒仍只有一条，不会因为清单长就多响。
            -->
            <LinearLayout
                android:id="@+id/rowItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 清单行首：左边「清单 2/5」，右边一个真箭头（原来用 ∨ 文字，太丑） -->
                <LinearLayout
                    android:id="@+id/rowItemsHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/tvItemProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12.5sp" />

                    <ImageView
                        android:id="@+id/ivItemsChevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/group_collapse"
                        android:src="@drawable/ic_expand_more"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxItemList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
              进度区：标签行（左：「第 N/M 组 · %」，右：− / ＋ 紧凑并排），
              下面通栏拖动条。
            -->
            <LinearLayout
                android:id="@+id/boxProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSetInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/set_minus_desc"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/set_minus_sign"
                        android:textColor="@color/app_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/app_card_alt"
                        app:cornerRadius="14dp"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/set_plus_desc"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/set_plus_sign"
                        android:textColor="@color/accent_on"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="14dp"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <!--
                  分块进度条（v3.34.79，参考稿 group-progress-blocks）：
                  一格 = 一组（组模式）或 5%（百分比模式），由 bindTask 填充；
                  点某一格直接推进到该进度（原拖动条的快速跳档替代）。
                -->
                <LinearLayout
                    android:id="@+id/rowProgressBlocks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <!-- 说明行（参考稿 exercise-caption）：每组几次，无组数时隐藏 -->
                <TextView
                    android:id="@+id/tvSetCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
              footer（v3.34.77，dark-task-cards 的 task-footer）：发丝线分隔，
              左边信息行（次数 · 截止 · 重复 · 催促 · 复查），右边编辑⋯。
              以前编辑是左侧动作列第二颗圆钮，现在按参考稿收进右下。
            -->
            <View
                android:id="@+id/footerDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/app_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp">

                <TextView
                    android:id="@+id/tvTaskMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.35"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/btnEdit"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_edit_task"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_more"
                    app:tint="@color/app_text_sub" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
