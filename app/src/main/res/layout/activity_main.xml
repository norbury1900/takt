<?xml version="1.0" encoding="utf-8"?>
<!--
  首页（v3.34.65 参照 app_html/mobile-ui-replica_red 重排）。
  五个页签（今天 / 计划 / 已完成 / 全部 / 历史）= 底部悬浮玻璃胶囊导航：
  纯图标（44dp 圆位），选中 = 与新建按钮同径的中国红圆底；新建并入导航条右端。
    - 今天：今天该做、且还没完成的（做完的自动移走，不再和未完成混在一起）
    - 计划：房租这类「按日期重复」任务未来每一次的日期（到期那天才进「今天」）
    - 已完成：今天已经标记完成的
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_window">

    <!-- 顶栏（v3.34.73 回归页面流：不再悬浮压列表，菜单钮与下方内容有明确分界） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp"
        android:paddingTop="30dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:text="@string/app_title"
                android:textAppearance="@style/Text.Taktu.Display"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- 汉堡菜单（v3.34.69）：导入 / 统计 / 设置 收进一个入口，点开展开面板 -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_menu"
            android:padding="9dp"
            android:src="@drawable/ic_menu"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- 「全部」页的说明条：平时隐藏，切到全部才出现 -->
    <TextView
        android:id="@+id/tvAllHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.4"
        android:text="@string/all_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 节假日数据过期提示（v3.34.123）：只在该年数据未覆盖时出现，点 × 关闭本年度 -->
    <LinearLayout
        android:id="@+id/holidayHintRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHolidayHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnHolidayHintClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/holiday_hint_close"
            android:gravity="center"
            android:text="×"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 权限预警条 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/permBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/danger_container"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_info"
                app:tint="@color/danger_on_container" />

            <TextView
                android:id="@+id/permBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.45"
                android:textColor="@color/danger_on_container"
                android:textSize="12.5sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 列表 + 悬浮导航（导航浮在列表上，列表底部留 108dp 避让；listRoot = 磨砂取景根） -->
    <FrameLayout
        android:id="@+id/listRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="108dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:alpha="0.25"
                android:src="@drawable/ic_alarm"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/empty_title"
                android:textAppearance="@style/Text.Taktu.Display"
                android:textColor="?attr/colorOnSurface"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/emptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/empty_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
          汉堡菜单展开面板（v3.34.69）：玻璃底浮层，默认收起，btnMenu 点开。
          三行的 id 沿用旧顶栏按钮（btnImport/btnStats/btnSettings），监听逻辑不用改绑定名。
        -->
        <!-- v3.34.80：面板改真磨砂（BlurView 抓 listRoot 高斯模糊），玻璃描边/圆角仍走 bg_menu_panel -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/boxMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_menu_panel"
            android:elevation="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

            <LinearLayout
                android:id="@+id/btnImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/btn_import"
                    android:src="@drawable/ic_import"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/btn_stats"
                    android:src="@drawable/ic_stats"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/settings_title"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <!--
          底部悬浮磨砂玻璃导航（v3.34.67）：BlurView 实时抓 listRoot 内容高斯模糊，
          真磨砂玻璃；描边走 foreground（bg_nav_pill_stroke），tint 走内层背景 glass_tint。
        -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/boxNav"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:elevation="8dp"
            android:background="@drawable/bg_nav_pill"
            android:foreground="@drawable/bg_nav_pill_stroke">

            <LinearLayout
                android:id="@+id/boxNavInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="7dp">

            <FrameLayout
                android:id="@+id/tabToday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_today"
                    android:padding="12dp"
                    android:src="@drawable/ic_alarm"
                    app:tint="@color/app_text_sub" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabPlan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_plan"
                    android:padding="12dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/app_text_sub" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabDone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_done"
                    android:padding="12dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/app_text_sub" />
            </FrameLayout>

            <!--
              全部：把未来日期的、长期的任务也列出来。
              以前只有「今天」一个入口，某月某天的一次性任务在当天之前根本看不见，
              想改也找不到入口 —— 加这一页就是给「回头修改」用的。
            -->
            <FrameLayout
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_all"
                    android:padding="12dp"
                    android:src="@drawable/ic_list"
                    app:tint="@color/app_text_sub" />
            </FrameLayout>

            <!--
              历史：已完成 / 已过期的一次性任务沉到这里，只保留约一个月。
              超期后不再显示（记录还在库里，统计照算），也不用去「全部」页翻旧账。
            -->
            <FrameLayout
                android:id="@+id/tabHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_history"
                    android:padding="12dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/app_text_sub" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnNew"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_circle_accent"
                android:contentDescription="@string/btn_new"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_add"
                app:tint="@color/accent_on" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>
    </FrameLayout>
</LinearLayout>
