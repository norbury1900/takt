<?xml version="1.0" encoding="utf-8"?>
<!--
  计划页的月历卡（v3.34.80，参照 dark-task-cards.html 的 calendar-panel）：
  整块日历收进一张圆角卡片，网格下方补图例（已完成 / 部分完成 / 无完成记录）。
  内部仍是 ViewPager2 左右滑翻月 + 星期表头 + 7×6 格子（格子由代码按页动态填充），
  id 全部保留（CalVH 绑定不变）。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/app_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/app_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- 月历头：标题绝对居中，左右各一颗无边框圆钮翻月 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="start|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cal_prev"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/app_text_sub" />

            <TextView
                android:id="@+id/tvCalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/zhuque_fangsong"
                android:paddingBottom="2dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cal_next"
                android:padding="10dp"
                android:rotationY="180"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/app_text_sub" />
        </FrameLayout>

        <!-- 星期表头 -->
        <LinearLayout
            android:id="@+id/rowWeekHead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/app_stroke" />

        <!-- 日期格子：左右滑翻月，一页一个月（6 行 × 46dp = 276dp 定高） -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpMonths"
            android:layout_width="match_parent"
            android:layout_height="276dp"
            android:layout_marginTop="4dp"
            android:overScrollMode="never" />

        <!-- 图例（v3.34.81 收紧）：贴近网格，三组词之间拉开 22dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="@color/ok"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/status_done"
                android:textColor="@color/app_text_sub"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:text="●"
                android:textColor="@color/accent"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/cal_legend_partial"
                android:textColor="@color/app_text_sub"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:text="●"
                android:textColor="@color/app_stroke"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/cal_legend_none"
                android:textColor="@color/app_text_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
