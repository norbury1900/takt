<?xml version="1.0" encoding="utf-8"?>
<!--
  响铃页点某条任务后进入的「任务界面」。
  用途：响铃这一刻往往正是动手的时候 —— 在这里记组数（记 1 组）、勾清单子项，
  做完自动回响铃页（那时这条已从待办里消失）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <!-- 顶部：返回 + 任务名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRingTaskBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/edit_back_desc"
                android:src="@drawable/ic_chevron_left"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvRingTaskTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/Text.Taktu.Headline"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRingTaskMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.4"
            android:textAppearance="@style/Text.Taktu.Meta"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 组数：记 1 组 / 退一组 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRingSets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/app_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRingTaskSetInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/Text.Taktu.Title"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRingTaskMinus"
                        style="@style/Widget.Taktu.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/back_one_set"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRingTaskPlus"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1.6"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/ring_set_plus"
                        android:textColor="@color/accent_on"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 清单：一行一项，点一下勾掉 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRingItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/app_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvRingTaskItemInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.Taktu.Title"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/boxRingTaskItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 一键完成整条 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRingTaskDone"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/ring_done"
            android:textColor="@color/accent_on"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="21dp"
            app:strokeWidth="0dp" />
    </LinearLayout>
</ScrollView>
