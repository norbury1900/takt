<?xml version="1.0" encoding="utf-8"?>
<!--
  标签分组的容器：不再是第二层卡片（卡中卡是层级发闷的根源），
  这里只做透明排版层——组头 + 任务卡直接坐在页面底色上，
  层次交给「组头小标签 + 卡片底色差」表达，而不是层层套框。
  保持 MaterialCardView 类型不变：MainActivity 的 GroupVH 直接强转根视图。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingTop="0dp"
        android:paddingEnd="2dp"
        android:paddingBottom="0dp">

        <!-- 组头：只有这一行可点击，点组内任务之间的空隙不该折叠整组 -->
        <LinearLayout
            android:id="@+id/rowHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="9dp">

            <View
                android:id="@+id/dotAccent"
                android:layout_width="8dp"
                android:layout_height="8dp" />

            <TextView
                android:id="@+id/tvTagName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTagCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/group_collapse"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 组内任务卡 -->
        <LinearLayout
            android:id="@+id/groupContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
