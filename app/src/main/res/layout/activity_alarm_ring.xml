<?xml version="1.0" encoding="utf-8"?>
<!--
  响铃全屏页。
  配色完全跟随用户选的浅 / 深主题（背景、图标、按钮都走 @color / ?attr）。
  结构：顶部标识 / 主任务大标题 / **未完成清单**（同一时间点到点却还没做的全列出来）/ 底部操作。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window"
    android:orientation="vertical">

    <!-- 主体（可滚动，任务多时也能看全） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="44dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/ring_tag_pre"
                    android:src="@drawable/ic_bell"
                    app:tint="?attr/colorOnPrimaryContainer" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.22"
                android:text="@string/ring_tag_pre"
                android:textAppearance="@style/Text.Taktu.Label"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/zhuque_fangsong"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="任务"
                android:textColor="?attr/colorOnSurface"
                android:textSize="29sp" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:textAppearance="@style/Text.Taktu.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- 未完成清单：同一时间点还没做的，全部平铺列出来（不做卡片） -->
            <LinearLayout
                android:id="@+id/boxOthers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvOthersTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="2dp"
                    android:letterSpacing="0.06"
                    android:text="@string/ring_others_title"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/listOthers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutAnimation="@anim/ta_layout_stagger"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:text="@string/ring_done_btn"
            android:textColor="@color/accent_on"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/accent_on"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnooze"
            style="@style/Widget.Taktu.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/ring_snooze"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_snooze"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/app_text"
            app:strokeColor="@color/app_stroke"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>
