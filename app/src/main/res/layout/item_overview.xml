<?xml version="1.0" encoding="utf-8"?>
<!--
  今日概览卡（v3.34.69，参考稿 dashboard 屏的 greeting 区）：
  红色渐变底压住整页玻璃的「单调」，问候 + 日期 + 今日任务完成度 + 细进度条。
  只出现在「今天」页签的第一个位置（MainActivity 在 submit 时塞进 rows）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_overview"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="30dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- 问候行（v3.34.80：卡片内汉堡移除，汉堡统一回顶栏右上） -->
    <TextView
        android:id="@+id/tvOverviewHi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_on"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOverviewSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.35"
        android:textColor="@color/overview_sub"
        android:textSize="14sp" />

    <!-- 完成度细条（v3.34.87）：圆角轨道 + 圆角填充，fill/spacer 权重由代码分配 -->
    <LinearLayout
        android:id="@+id/ovTrack"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_bar"
        android:backgroundTint="@color/overview_track"
        android:orientation="horizontal">

        <View
            android:id="@+id/ovFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/bg_bar"
            android:backgroundTint="@color/accent_on" />

        <View
            android:id="@+id/ovSpacer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 外部控制开关：不用再进设置页 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/control_title"
            android:textColor="@color/overview_sub"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ovControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
