<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件深色玻璃底（v3.34.92 与浅色同款渐变玻璃）：
     系统深色时由 TodayWidget 经 RemoteViews.setInt("setBackgroundResource") 切换，
     布局里不直接引用。真模糊 RemoteViews 无 API，只能透色 + 渐变 + 亮边模拟 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#E6262119"
        android:centerColor="#C9221E1B"
        android:endColor="#B81C1917" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
