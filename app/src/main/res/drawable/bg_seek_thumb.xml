<?xml version="1.0" encoding="utf-8"?>
<!-- 进度滑块：暖白小圆 + 陶土橘圆环 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/app_card" />
            <stroke
                android:width="2.5dp"
                android:color="@color/accent" />
            <size
                android:width="16dp"
                android:height="16dp" />
        </shape>
    </item>
</layer-list>
