<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件背景：奶油色「玻璃」底（v3.34.92 对齐新浅色色板 + 加光泽）。
     真磨砂（模糊壁纸）RemoteViews 没有平台 API —— 桌面进程渲染，拿不到壁纸像素，
     只能靠「半透明 + 上亮下暗的渐变 + 亮边」模拟磨砂观感。固定浅色，不跟系统深色 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#F2FFFDFA"
        android:centerColor="#D9FAF6EF"
        android:endColor="#C6F1EBE1" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
</shape>
