<?xml version="1.0" encoding="utf-8"?>
<!--
  页面底 · 深色（v3.34.66）：深底 + 光晕。
  参照 app_html/mobile-ui-replica_red 深色日程屏的 radial-gradient 光斑
  （右上偏红、左下鎏金），磨砂玻璃的半透卡透出光才有玻璃感。
  浅色主题继续用 drawable/bg_window.xml（纯色），不受影响。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_bg" />
        </shape>
    </item>
    <!-- 右上：红色光晕 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.9"
                android:centerY="0.12"
                android:gradientRadius="520dp"
                android:startColor="#3EBC2924"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- 左下：鎏金光晕 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.08"
                android:centerY="0.92"
                android:gradientRadius="560dp"
                android:startColor="#2DDEBD81"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- 中部：极淡的红棕补光，避免中间一大片死黑 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.55"
                android:gradientRadius="640dp"
                android:startColor="#16861D1B"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
